---
import '../styles/global.css';
import { SITE } from '../config';
import { getIssues, pad } from '../lib/content';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = SITE.tagline } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · ${SITE.tagline}`;
const path = Astro.url.pathname;
const issues = await getIssues();
const latest = issues[0];
const socials = SITE.social.filter((s) => s.href && s.href !== '#');
const nav = [
  ['/', 'Home'],
  ['/about/', 'About'],
  ['/editions/', 'Past Editions'],
  ['/department/', 'In the Department'],
  ['/contact/', 'Reach Out'],
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{pageTitle}</title>
  <meta name="description" content={description}>
  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,700;0,900;1,500&family=Source+Serif+4:ital,wght@0,400;0,600;1,400&family=Inter:wght@500;600&display=swap" rel="stylesheet">
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <div class="topbar"><div class="wrap">
    <span>{SITE.dept}</span>
    {latest && <span>Issue {pad(latest.data.number)} · Latest</span>}
  </div></div>
  <header class="masthead"><div class="wrap">
    <a class="logo" href="/">{SITE.name}</a>
    <div class="tag">{SITE.tagline}</div>
  </div></header>
  <nav class="main" aria-label="Main"><div class="wrap">
    {nav.map(([href, label]) => (
      <a href={href} aria-current={(href === '/' ? path === '/' : path.startsWith(href)) ? 'page' : undefined}>{label}</a>
    ))}
  </div></nav>

  <main id="main"><slot /></main>

  <footer class="site"><div class="wrap">
    {socials.length > 0 && (
      <div class="soc">{socials.map((s) => <a href={s.href} rel="noopener" target="_blank">{s.label}</a>)}</div>
    )}
    © {new Date().getFullYear()} {SITE.name} · {SITE.dept}<br>
    <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
  </div></footer>
</body>
</html>
