---
import '../styles/fonts.css';
import '../styles/global.css';
import { SITE } from '../config';
import { getIssues, pad } from '../lib/content';

interface Props {
  title?: string;
  description?: string;
  // Thin reading-progress bar at the top of the page (used on blog posts).
  progress?: boolean;
}
const { title, description = SITE.tagline, progress = false } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · ${SITE.tagline}`;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site).toString();
const issues = await getIssues();
const latest = issues[0];
const socials = SITE.social.filter((s) => s.href && s.href !== '#');
const nav = [
  ['/', 'Home'],
  ['/about/', 'About'],
  ['/team/', 'Team'],
  ['/issues/', 'Issues'],
  ['/blog/', 'Blog'],
  ['/department/', 'In the Department'],
  ['/submit/', 'Submit'],
  ['/resources/', 'Resources'],
  ['/contact/', 'Reach Out'],
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{pageTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <meta property="og:site_name" content={SITE.name}>
  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:type" content="website">
  <meta name="twitter:card" content="summary">
  <meta name="theme-color" content="#7a1f2b">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="sitemap" href="/sitemap-index.xml">
  <link rel="alternate" type="application/rss+xml" title={`${SITE.name} blog`} href="/rss.xml">
  <link rel="preload" href="/fonts/source-serif-4-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/playfair-display-latin-900-normal.woff2" as="font" type="font/woff2" crossorigin>
  <!-- Animations and the phone menu only kick in when JavaScript runs; without it everything is simply visible. -->
  <script is:inline>document.documentElement.classList.add('js')</script>
</head>
<body>
  {progress && <div class="progress" aria-hidden="true"></div>}
  <a class="skip" href="#main">Skip to content</a>
  <div class="topbar"><div class="wrap">
    <span>{SITE.dept}</span>
    {latest && <span>Issue {pad(latest.data.number)} · Latest</span>}
  </div></div>
  <header class="masthead"><div class="wrap">
    <a class="logo" href="/">{SITE.name}</a>
    <div class="tagline">{SITE.tagline}</div>
  </div></header>
  <nav class="main" aria-label="Main">
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="nav-links">Menu</button>
    <div class="wrap" id="nav-links">
      {nav.map(([href, label]) => (
        <a href={href} aria-current={(href === '/' ? path === '/' : path.startsWith(href)) ? 'page' : undefined}>{label}</a>
      ))}
    </div>
  </nav>

  <main id="main"><slot /></main>

  <footer class="site"><div class="wrap">
    {socials.length > 0 && (
      <div class="soc">{socials.map((s) => <a href={s.href} rel="noopener" target="_blank">{s.label}</a>)}</div>
    )}
    © {new Date().getFullYear()} {SITE.name} · {SITE.dept}<br>
    <a href={`mailto:${SITE.email}`}>{SITE.email}</a> · <a href="/rss.xml">RSS</a>
  </div></footer>

  <script>
    // Phone menu toggle.
    const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
    const nav = document.querySelector('nav.main');
    btn?.addEventListener('click', () => {
      const open = nav!.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(open));
      btn.textContent = open ? 'Close' : 'Menu';
    });

    // Fade sections and cards in as they scroll into view (skipped for reduced-motion users).
    // Uses plain position checks rather than IntersectionObserver, which can miss the first
    // check on pages opened through a cross-page view transition and leave content invisible.
    // Elements only get the hidden "reveal" state from this script, so if it never runs, nothing is hidden.
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const groups = [
        '.hero > *', '.page-head', 'section.block > h2', 'section.block > .sub',
        '.featured > *', '.posts > .post', '.editions > *', '.events > *', '.res-grid > *',
        '.about > *', '.post-head', '.contact-grid > *', '.team-grid > *',
      ];
      let pending: HTMLElement[] = [];
      for (const sel of groups) {
        document.querySelectorAll<HTMLElement>(sel).forEach((el) => {
          const i = el.parentElement ? [...el.parentElement.children].indexOf(el) : 0;
          el.style.setProperty('--d', `${Math.min(i, 5) * 80}ms`);
          el.classList.add('reveal');
          pending.push(el);
        });
      }
      let queued = false;
      const check = () => {
        queued = false;
        const limit = innerHeight - 30;
        pending = pending.filter((el) => {
          const r = el.getBoundingClientRect();
          // Hidden elements (e.g. filtered-out blog posts) have no size; keep them for later.
          if (r.height > 0 && r.top < limit && r.bottom > 0) {
            el.classList.add('in');
            return false;
          }
          return true;
        });
        if (!pending.length) removeEventListener('scroll', schedule);
      };
      // A short timer rather than requestAnimationFrame, which pauses in background tabs.
      const schedule = () => {
        if (!queued) {
          queued = true;
          setTimeout(check, 50);
        }
      };
      addEventListener('scroll', schedule, { passive: true });
      addEventListener('resize', schedule);
      addEventListener('pagereveal', schedule);
      addEventListener('pageshow', schedule);
      // The blog page fires this after filtering, since newly shown posts don't scroll.
      addEventListener('reveal:check', schedule);
      schedule();
      setTimeout(check, 400);
    }
  </script>
</body>
</html>
