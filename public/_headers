# Cloudflare Pages response headers.
# The main Content-Security-Policy is added to each page by Astro (see astro.config.mjs).
# frame-ancestors only works as a header, so it is set here.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'; object-src 'none'; base-uri 'self'
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Files uploaded through the editor panel (PDFs, images) are shown, never run: a hostile SVG cannot
# execute script on this domain. PDFs still open normally.
/uploads/*
  Content-Security-Policy: script-src 'none'

# Editor panel: only scripts served by this site may run (Decap needs 'unsafe-eval' internally).
# If sign-in fails once the OAuth proxy exists, check the browser console for a blocked domain.
/admin/*
  X-Robots-Tag: noindex
  Cache-Control: no-cache
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self' https://api.github.com; frame-src 'self' blob: https://www.youtube-nocookie.com https://open.spotify.com; font-src 'self' data:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'

# Keep the pages.dev copies of the site (production and draft previews) out of search results;
# the real address is epistemejamia.in.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
